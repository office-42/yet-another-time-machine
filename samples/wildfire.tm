image	land	pictures/landcover.png
format	M5	0%
format	Z5	0
cell	A1	Where will the fire go? A spread model over a land-cover picture
cell	A2	Start row
cell	D2	22
cell	F2	Start col
cell	I2	8
cell	K2	p
cell	M2	0.6
cell	O2	Hours
cell	R2	48
cell	T2	Wind from
cell	W2	225
cell	Y2	m/s
cell	AB2	4
cell	A3	The land cover, its colour on the picture and how well it burns are in AQ3:AS8.
cell	AQ3	Land
cell	AR3	Colour
cell	AS3	Fuel
cell	AQ4	forest
cell	AR4	#2e7d32
cell	AS4	1.0
cell	A5	Chance the town burns (F5)
cell	M5	=SIM.MEAN(M6)
cell	P5	Expected cells burnt
cell	Z5	=SIM.MEAN(Z6)
cell	AQ5	grass
cell	AR5	#c5e17a
cell	AS5	0.6
cell	A6	Town burns, this future
cell	M6	=MAX(AF46:AK50)
cell	P6	Cells burnt, this future
cell	Z6	=SUM(B42:AO71)
cell	AQ6	town
cell	AR6	#9e9e9e
cell	AS6	0.25
cell	A7	Fuel, read off the picture's colours (select B8:AO37 for a heatmap):
cell	AQ7	road
cell	AR7	#555555
cell	AS7	0.05
