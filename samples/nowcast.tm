cell	A1	Rain at home in the next two hours: a radar nowcast
cell	A3	Home, lat
cell	B3	59.91
cell	D3	Chance of rain within the hour
cell	H3	=SIM.MEAN(H4)
cell	A4	Home, lon
cell	B4	10.75
cell	D4	Rain within the hour, this future
cell	H4	=OR(B19:H19)
cell	A5	Motion east, a frame (share of width)
cell	B5	=IMAGE.MOTION("radar_0","radar_1","dx",0.1)
cell	D5	Share of the radar showing rain now
cell	H5	=IMAGE.FRACTION("radar_1","saturation",">0.3")
cell	A6	Motion south, a frame (share of height)
cell	B6	=IMAGE.MOTION("radar_0","radar_1","dy",0.1)
cell	A7	Speed (km/h)
cell	B7	=6*SQRT((GEO.DISTANCE(59.5,4,59.5,14)*B5)^2+(GEO.DISTANCE(57,9,62,9)*B6)^2)
cell	D7	Select A3:B4 to see home on the radar frame; select a row of
cell	A8	Motion east, this future
cell	B8	=RAND.NORMAL(B5,0.25*ABS(B5)+0.002)
cell	D8	rain rates for its fan; the block below maps the nowcast.
cell	A9	Motion south, this future
cell	B9	=RAND.NORMAL(B6,0.25*ABS(B6)+0.002)
cell	A10	Home on the radar, u
cell	B10	=IMAGE.XY("radar_1",B3,B4,"u")
cell	A11	Home on the radar, v
cell	B11	=IMAGE.XY("radar_1",B3,B4,"v")
cell	A13	Minutes ahead
cell	B13	0
cell	C13	10
cell	D13	20
cell	E13	30
cell	F13	40
cell	G13	50
cell	H13	60
cell	I13	70
cell	J13	80
cell	K13	90
cell	L13	100
cell	M13	110
cell	N13	120
cell	A14	Where the rain comes from, u
cell	B14	=$B$10-B13/10*$B$8
cell	C14	=$B$10-C13/10*$B$8
cell	D14	=$B$10-D13/10*$B$8
cell	E14	=$B$10-E13/10*$B$8
cell	F14	=$B$10-F13/10*$B$8
