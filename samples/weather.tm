cell	A21	Rain follows rain: a Markov chain, counted from the last 60 days
cell	B22	dry
cell	C22	rain
cell	A23	dry
cell	B23	=MARKOV.ESTIMATE("dry","dry",$B$36:$B$95,1)
cell	C23	=MARKOV.ESTIMATE("dry","rain",$B$36:$B$95,1)
cell	A24	rain
cell	B24	=MARKOV.ESTIMATE("rain","dry",$B$36:$B$95,1)
cell	C24	=MARKOV.ESTIMATE("rain","rain",$B$36:$B$95,1)
cell	A25	Long-run share of rainy days
cell	B25	=MARKOV.STEADY("rain",A23:A24,B23:C24)
cell	A26	Rain a week from now, exactly
cell	B26	=MARKOV.PROB(B4,"rain",A23:A24,B23:C24,7)
